# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/prediction_finder

# Redis (BullMQ + Streams)
REDIS_URL=redis://localhost:6379

# API
API_PORT=3001
API_HOST=0.0.0.0

# Web
NEXT_PUBLIC_API_URL=http://localhost:3001

# ─── Worker ────────────────────────────────────────────────────────────────────

# The Odds API  (https://the-odds-api.com)
ODDS_API_KEY=your_odds_api_key_here

# Comma-separated sport keys to poll (see https://the-odds-api.com/sports-odds-data/sports-apis.html)
ODDS_API_SPORTS=americanfootball_nfl,basketball_nba,baseball_mlb

# Milliseconds between polls per sport (default: 30000 = 30s)
ODDS_API_POLL_INTERVAL_MS=30000

# Odds API regions filter (default: us)
ODDS_API_REGIONS=us

# Odds API markets filter (default: h2h,spreads,totals)
ODDS_API_MARKETS=h2h,spreads,totals

# BullMQ worker concurrency (default: 5)
WORKER_CONCURRENCY=5

# Sportsbook scraper schedule — semicolon-separated entries
# Format: slug,sport,url,intervalSeconds
# SCRAPE_BOOKS=draftkings,americanfootball_nfl,https://sportsbook.draftkings.com/football/nfl,60;fanduel,americanfootball_nfl,https://setthetail.fanduel.com/gaming/sports/american-football/nfl,60
