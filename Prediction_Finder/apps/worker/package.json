    "ioredis": "5.10.1",
    "playwright": "^1.61.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "rimraf": "^6.0.1",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4"
  }
}
